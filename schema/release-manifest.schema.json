{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wahltho/X-Plane-LevelUp-737NG-Lufthansa-Livery/blob/main/schema/release-manifest.schema.json",
  "title": "LevelUp Lufthansa livery release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageType",
    "packageId",
    "packageVersion",
    "releaseTag",
    "channel",
    "repository",
    "supportedProducts",
    "supportedVariants",
    "installScope",
    "targetDirectory",
    "archiveRoot",
    "restartRequired",
    "releaseDate",
    "source",
    "aircraft",
    "livery",
    "rights",
    "archive",
    "files",
    "totals",
    "validation"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "packageType": {"const": "livery"},
    "packageId": {"const": "wahltho.levelup-737ng.livery.lufthansa"},
    "packageVersion": {"const": "1.0.0"},
    "releaseTag": {"const": "v1.0.0"},
    "channel": {"const": "stable"},
    "repository": {
      "const": "https://github.com/wahltho/X-Plane-LevelUp-737NG-Lufthansa-Livery"
    },
    "supportedProducts": {"const": ["levelup-737ng"]},
    "supportedVariants": {"const": ["737-700", "737-900ER"]},
    "installScope": {"const": "aircraftLivery"},
    "targetDirectory": {"const": "Lufthansa"},
    "archiveRoot": {"const": "Lufthansa"},
    "restartRequired": {"const": true},
    "releaseDate": {"type": "string", "format": "date"},
    "source": {"type": "object"},
    "aircraft": {"type": "object"},
    "livery": {"type": "object"},
    "rights": {"type": "object"},
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "size", "sha256", "method"],
      "properties": {
        "fileName": {
          "const": "X-Plane-LevelUp-737NG-Lufthansa-Livery-v1.0.0.zip"
        },
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "method": {"const": "stored"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256", "variants", "required"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!Lufthansa/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "size": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "variants": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["737-700", "737-900ER"]}
          },
          "required": {"const": true}
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileCount", "uncompressedBytes"],
      "properties": {
        "fileCount": {"const": 9},
        "uncompressedBytes": {"const": 128058204}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forbiddenPatterns"],
      "properties": {
        "forbiddenPatterns": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
